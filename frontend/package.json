    "lucide-react": "^0.517.0",
    "next": "^15.3.1",
    "next-auth": "5.0.0-beta.27",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.57.1",
    "shadcn-dropzone": "^0.2.1",
    "sonner": "^2.0.4",
    "tailwind-merge": "^3.3.0",
    "uuid": "^9.0.1",
    "zod": "^3.24.4"
